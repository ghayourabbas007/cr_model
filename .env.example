# Copy to .env and adjust. Never commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console

# --- Database (MySQL 8) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=forecaster
DB_PASSWORD=change-me
DB_NAME=crypto_forecast
# Optional: full SQLAlchemy URL overrides the DB_* parts above
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/crypto_forecast?charset=utf8mb4

# --- Market data ---
# Comma-separated Binance spot symbols. Add BTCUSDT, ETHUSDT, ... here.
SYMBOLS=SOLUSDT,BTCUSDT,ETHUSDT
# Symbols used as the primary forecast targets (others are context / cross-asset factors)
TARGET_SYMBOLS=SOLUSDT
INTERVALS=1d,4h
BACKFILL_START=2020-08-01
BINANCE_BASE_URL=https://api.binance.com
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_DATA_DUMP_URL=https://data.binance.vision
BINANCE_WEIGHT_SOFT_LIMIT=3000
# Funding rate + open interest from USD-M futures (public endpoints)
INCLUDE_MARKET_CONTEXT=true
# Incremental updater schedule, UTC (5 minutes after each 4h candle closes)
UPDATE_CRON_HOURS=0,4,8,12,16,20
UPDATE_CRON_MINUTE=5

# --- Features ---
CROSS_ASSET_SYMBOLS=BTCUSDT,ETHUSDT
INCLUDE_FUNDING_FEATURES=true
# Only ~30 days of OI history exist on Binance; enable once enough has accumulated
INCLUDE_OI_FEATURES=false

# --- Forecasting ---
FORECAST_HORIZONS=7,14
MODEL_DIR=artifacts/models
# Models evaluated by `forecaster train` (climatology baseline is always included)
TRAIN_MODELS=climatology,momentum,lgbm,xgb,lstm
# Model used by `forecaster predict` and the API
SERVING_MODEL=lgbm
# Walk-forward: first test block after this many days; test blocks of WF_TEST_DAYS
WF_MIN_TRAIN_DAYS=365
WF_TEST_DAYS=90
# Set for a rolling (instead of expanding) training window
# WF_MAX_TRAIN_DAYS=730
LSTM_SEQ_LEN=30
LSTM_EPOCHS=60
RANDOM_SEED=42

# --- Backtest costs (basis points) ---
FEE_BPS=10
SLIPPAGE_BPS=5
# Strategy: long when P(up) >= BT_ENTER_LONG, flat when it drops below BT_EXIT_LONG.
# Fixed in advance; do not tune these on backtest results.
BT_ENTER_LONG=0.55
BT_EXIT_LONG=0.50
BT_ALLOW_SHORT=false
BT_ENTER_SHORT=0.45
BT_EXIT_SHORT=0.50
# Also require the median forecast to agree with the direction
BT_REQUIRE_MEDIAN_AGREES=false
BT_BOOTSTRAP_SAMPLES=2000
BT_BOOTSTRAP_BLOCK=20

# --- Optional API keys ---
# NOT required: the system only uses public endpoints and never trades.
# If ever set, they are read from the environment only.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
